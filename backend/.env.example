NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m
REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_SECRET
REFRESH_EXPIRES_IN=7d

MONGO_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@cluster0.xxxxx.mongodb.net/food-inspection-monitor?retryWrites=true&w=majority&appName=Cluster0

LOG_LEVEL=info
UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760
